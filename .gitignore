# 依赖与构建产物
__pycache__/
*.pyc
node_modules/
dist/
dsh/nju-lab-client/lib/

# 密钥与环境（绝不提交）
.env
*.local

# 运行时产物
.verify-scratch/
server/uploads/
dsh/verify-poc/runs/
dsh/nju-lab-client/nju-lab/
.reasonix/
*.log

# 编辑器
*.swp
.DS_Store

# 浏览器验证的截图产物（tools/verify-slides.mjs 生成）
web/tools/shots/

# 插件包产物（由 dsh/kit/build-plugin-zips.sh 生成并投放 /var/www/lab/kit/，不入库）
dsh/kit/artifacts/*.zip
