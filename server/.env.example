DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=nju_lab
DB_PASSWORD=nju_lab_dev
DB_DATABASE=nju_lab

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

PORT=3000

# 文件上传根目录（默认 server/uploads）
UPLOAD_DIR=uploads

# 南京大学统一身份认证（CAS 3.0）；CAS_BASE_URL 为空表示未启用
CAS_BASE_URL=
CAS_VALIDATE_PATH=/p3/serviceValidate
# 平台公网根地址（拼 CAS service 回调；启用 CAS 必填）
PUBLIC_BASE_URL=

# 复验执行器：mock（默认，确定性模拟）| docker（一次性容器真实复验，需本机 Docker + nju-lab-verify 镜像）
EVALUATION_RUNNER=mock
# docker 模式可选配置（均有默认值）：
#VERIFY_IMAGE=nju-lab-verify:0.1.5-rc.2
#VERIFY_TIMEOUT_MS=600000
#VERIFY_MAX_CASES=0
#VERIFY_JUDGE_MODE=llm
#VERIFY_DOCKER_MEMORY=1g
#VERIFY_DOCKER_CPUS=1
# docker 模式必需：复验容器内模型调用的 key（OpenAI 兼容路由，透传进容器）
#MOONSHOT_API_KEY=
