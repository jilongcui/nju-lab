DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=nju_lab
DB_PASSWORD=nju_lab_dev
DB_DATABASE=nju_lab

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

PORT=3000

# 文件上传根目录（默认 server/uploads）
UPLOAD_DIR=uploads

# 南京大学统一身份认证（CAS 3.0）；CAS_BASE_URL 为空表示未启用
CAS_BASE_URL=
CAS_VALIDATE_PATH=/p3/serviceValidate
# 平台公网根地址（拼 CAS service 回调；启用 CAS 必填）
PUBLIC_BASE_URL=

# 复验执行器：mock（默认，确定性模拟）| docker（一次性容器真实复验，需本机 Docker + nju-lab-verify 镜像）
EVALUATION_RUNNER=mock
# docker 模式可选配置（均有默认值）：
#VERIFY_IMAGE=nju-lab-verify:0.2.0-rc.2-pkg3
#VERIFY_TIMEOUT_MS=600000
# 判分与成本控制：**留空/不写 = 不下发 CLI 参数**，由数据集包的 manifest.json
#（judgeMode / maxCases）决定；写在这里是平台级强制覆盖（优先级高于包声明）
#VERIFY_MAX_CASES=0
#VERIFY_JUDGE_MODE=llm
#VERIFY_DOCKER_MEMORY=1g
#VERIFY_DOCKER_CPUS=1
# ⚠️ ML 类实验（torch / scikit-learn）建议把内存调到 2g：默认 1g 在 CPU 上跑训练容易 OOM
#（njuserver 内存充足；本机内存紧张，慎调）
# docker 模式必需：复验容器内模型调用的 key（OpenAI 兼容路由，透传进容器）
#MOONSHOT_API_KEY=

# ---- 平台侧实验工作台（兜底环境）----
# 镜像（构建见 server/workspace-image/README.md）；容器编排复用 EVALUATION_RUNNER=docker 那套隔离设施
#WORKSPACE_IMAGE=nju-lab-workspace:0.2.0-rc.2-pkg2
#WORKSPACE_MEMORY=1g
#WORKSPACE_CPUS=0.5
# 容器内转发端口（与 workspace-image/entrypoint.mjs 约定一致）
#WORKSPACE_CONTAINER_PORT=9090
# 同时在线实例上限
#WORKSPACE_MAX_TOTAL=60
# 空闲回收（秒）与扫描间隔（秒）
#WORKSPACE_IDLE_TIMEOUT_SECONDS=1800
#WORKSPACE_SWEEP_INTERVAL_SECONDS=60
# 学生容器要访问的平台 API 基址（容器在隔离网络里，后端会把该域名指到宿主网关）
#WORKSPACE_PLATFORM_API=http://medai.nju.edu.cn/lab/api
# 反向代理的对外基址。dsh 的运行时路径全锚定 origin 根（/api、/plugins、
# WebSocket /api/remote.mux），只有两种形态跑得通（2026-09-28 实测）：
#   形态 A（首选，需独立域名或端口）：https://{key}.ws.example.com
#   形态 B（单 Host + cookie 分流，medai 实际采用）：http://medai.nju.edu.cn
# 后端据此算容器要信任的 authority（注入 --trusted-host）——不配则 WebSocket 403。
# 细节见 docs/DESIGN-2026-09-28-platform-workspace.md §4.5.1 / §4.5.2
#WORKSPACE_PUBLIC_BASE=
# 额外信任的 authority（逗号分隔）。{key} 展开后的 authority 由后端自动加入，无需在此重复
#WORKSPACE_TRUSTED_HOSTS=
# 学生工作区的持久化根目录（宿主路径）：<根>/<userId> → 容器 /work，
# <根>/<userId>/dsh-sessions → $DSH_HOME/sessions。留空 = 关闭持久化。
# ⚠️ 必须可写；不可写时后端只告警、不挂载（学生仍可用，但文件随容器消失）
#WORKSPACE_DATA_DIR=/data/workspaces
# 是否启用「WS→HTTPS 桥」（网关不透传 WebSocket 时的替代通道；默认开）
# 网关侧开放 WS 后设为 0 即切回原生 WebSocket（页面适配脚本会自动退回，无需改前端/nginx）
#WORKSPACE_WS_BRIDGE=1
# 桥在容器内的监听端口（与 nginx 的 /wsbridge/ 上游一致）
#WORKSPACE_BRIDGE_PORT=9091
# 反代路径前缀（「单 Host + cookie 分流」形态用，必须与 nginx 的 location 一致）
#WORKSPACE_PROXY_PATH=/lab/ws
# 会话 cookie 名（同样必须与 nginx 的 $cookie_<name> 一致；nginx 变量名不允许 '-'，故用下划线）
#WORKSPACE_COOKIE_NAME=nju_ws

# ---- 章节在线幻灯片（reveal.js）----
# 生成器：mock（默认，确定性不烧额度）| llm（真实模型）
#SLIDES_GENERATOR=mock
# 模型与端点（OpenAI 兼容；key 只从 SLIDES_LLM_API_KEY_ENV 指的变量名现读）
#SLIDES_MODEL=deepseek-flash
#SLIDES_LLM_BASE_URL=https://api.deepseek.com
#SLIDES_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
# 分级用模型（可选）：大纲 / 扩写各用各的；缺省回落 SLIDES_MODEL
#SLIDES_OUTLINE_MODEL=
#SLIDES_EXPAND_MODEL=
# ⚠️ deepseek-flash / v4-pro 是推理模型：completion 预算与推理共用，长推理会烧光预算
# 导致 content 为空/截断（2026-09-29 实测）。结构化 JSON 任务用 low 即可。
# 合法值：none|minimal|low|medium|high|xhigh|max
#SLIDES_LLM_REASONING_EFFORT=low
# 生成限额（均有默认值，一般不用改）
#SLIDES_MAX_SLIDES=20
# 单次请求 completion 上限（含推理开销）；模型已支持 500K token 上下文，默认 32768
#SLIDES_MAX_TOKENS=32768
#SLIDES_EXPAND_BATCH=4
#SLIDES_GENERATE_PER_HOUR=20
#SLIDES_MAX_BULLETS=8
#SLIDES_MAX_CHARS=400
#SLIDES_MAX_NOTES=1000
# 生成器后置质检闸（只作用于 LLM 产出）：标题 / 单条要点字符上限
#SLIDES_TITLE_MAX_CHARS=30
#SLIDES_BULLET_MAX_CHARS=60
# 分节页「本节导览」条数硬闸（prompt 约定 2–3 条，超出管线内截断）
#SLIDES_SECTION_TEASER_MAX=3
# 送入模型的章节正文字符上限（默认 300000，约 30 万 token 内；超长才截断）
#SLIDES_SOURCE_MAX_CHARS=300000
# 单次请求超时（token 预算放大后响应变长，默认 5 分钟）
#SLIDES_LLM_TIMEOUT_MS=300000
