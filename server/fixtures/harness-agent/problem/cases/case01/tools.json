{
  "tools": [
    {
      "name": "lookup_record",
      "description": "查某个对象（人/设备）某一项最近一次记录",
      "parameters": {
        "subject": {
          "type": "string",
          "required": true
        },
        "item": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "name": "summarize_column",
      "description": "算某一项全部记录的算术平均值",
      "parameters": {
        "item": {
          "type": "string",
          "required": true
        },
        "decimals": {
          "type": "integer",
          "required": false
        }
      }
    },
    {
      "name": "fetch_doc",
      "description": "取某一项对应的规则段落号",
      "parameters": {
        "item": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "name": "flag_value",
      "description": "把一条异常记录登记为待复核（只接受异常记录）",
      "parameters": {
        "record_id": {
          "type": "string",
          "required": true
        }
      }
    }
  ]
}
