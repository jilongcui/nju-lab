{
  "title": "随访助手",
  "subtitle": "上传检验数据，生成一份可复核的报告。",
  "scenario": "把 PDF / Word / 图片里的检验数据按固定口径整理成报告",
  "entry": "harness/api.py",
  "theme": {
    "mode": "light",
    "accent": "#2f6feb"
  },
  "attachments": [
    "pdf",
    "docx",
    "image"
  ],
  "visibility": "teacher",
  "report": {
    "sections": [
      {
        "name": "目的",
        "min_chars": 20
      },
      {
        "name": "方法",
        "min_chars": 20
      },
      {
        "name": "结果",
        "min_chars": 30
      },
      {
        "name": "讨论",
        "min_chars": 30
      }
    ],
    "thresholds": {
      "PLT": {
        "low": 100,
        "high": 300
      },
      "WBC": {
        "low": 3.5,
        "high": 10
      },
      "HGB": {
        "low": 110,
        "high": 160
      }
    },
    "messages": {
      "warn": "该指标超出参考范围，请尽快由临床医生复核。"
    }
  }
}
